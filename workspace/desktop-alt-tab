#!/usr/bin/python3
"""Small icon switcher. Read Alt state only while its own menu is open."""
import ctypes as C
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time

lock=open(Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/'desktop-alt-tab.lock','w')
try: fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError: raise SystemExit(0)
x=C.CDLL('libX11.so.6')
x.XOpenDisplay.argtypes=[C.c_char_p];x.XOpenDisplay.restype=C.c_void_p
x.XQueryKeymap.argtypes=[C.c_void_p,C.c_char_p]
x.XKeysymToKeycode.argtypes=[C.c_void_p,C.c_ulong];x.XKeysymToKeycode.restype=C.c_ubyte
x.XCloseDisplay.argtypes=[C.c_void_p]
d=x.XOpenDisplay(None)
if not d: raise SystemExit(1)
alt=[x.XKeysymToKeycode(d,k) for k in [0xffe9,0xffea]]
def alt_held():
    keys=C.create_string_buffer(32);x.XQueryKeymap(d,keys)
    return any(keys.raw[k//8]&(1<<(k%8)) for k in alt)
reverse='--reverse' in sys.argv
args=['rofi','-no-config','-modi','window','-show','window','-show-icons',
      '-theme',str(Path.home()/'.config/rofi/alt-tab-icons.rasi'),
      '-selected-row','0' if reverse else '1',
      '-kb-accept-entry','Return','-kb-row-down','Alt+Tab,Alt+Down,Down',
      '-kb-row-up','Alt+ISO_Left_Tab,Alt+Up,Up','-kb-cancel','Escape']
p=subprocess.Popen(args)
reverse_done=not reverse
try:
    while p.poll() is None:
        if reverse_done and alt_held(): time.sleep(.015);continue
        result=subprocess.run(['xdotool','search','--pid',str(p.pid),'--class','Rofi'],capture_output=True,text=True)
        ids=result.stdout.splitlines()
        if not ids: time.sleep(.015);continue
        wid=ids[-1]
        if not reverse_done:
            subprocess.run(['xdotool','keydown','--window',wid,'Up'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
            reverse_done=True
            continue
        # Send only to this menu; no global keys or modifier changes.
        subprocess.run(['xdotool','keydown','--window',wid,'Return'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        try:p.wait(timeout=.3)
        except subprocess.TimeoutExpired:time.sleep(.015)
finally:
    if p.poll() is None:p.terminate();p.wait()
    x.XCloseDisplay(d)
