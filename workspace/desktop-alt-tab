#!/usr/bin/python3
"""Send one command to the preloaded menu; start it if not running yet."""
import os
import socket
import sys

path=os.path.join(os.environ.get('XDG_RUNTIME_DIR','/tmp'),'desktop-alt-tab-warm.sock')
message=b'prev' if '--reverse' in sys.argv else b'next'
def send():
    with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as sock:sock.sendto(message,path)
try:send()
except (FileNotFoundError,ConnectionRefusedError):
    import subprocess,time
    service=os.path.join(os.path.dirname(os.path.realpath(__file__)),'desktop-alt-tab-service.py')
    log=os.path.join(os.environ.get('XDG_RUNTIME_DIR','/tmp'),'desktop-alt-tab-service.log')
    with open(log,'a') as output:
        subprocess.Popen(['/usr/bin/python3',service],stdin=subprocess.DEVNULL,stdout=output,stderr=output,start_new_session=True)
    for _ in range(200):
        try:send();break
        except (FileNotFoundError,ConnectionRefusedError):time.sleep(.01)
    else:raise SystemExit('Could not start the desktop window switcher')
