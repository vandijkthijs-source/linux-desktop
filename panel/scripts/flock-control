#!/usr/bin/python3
import sys
import os
import fcntl
from pathlib import Path
import subprocess
APP=Path.home()/'.local/share/desktop-boids'
sys.path.insert(0,str(APP))
from settings import load,save
cfg=load(); action=sys.argv[1] if len(sys.argv)>1 else 'status'
if action=='status':
    print('Flock: ON' if cfg['enabled'] else 'Flock: OFF')
elif action in ('toggle','on','off'):
    cfg['enabled']=not cfg['enabled'] if action=='toggle' else action=='on';save(cfg)
    if cfg['enabled']:
        runtime=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/('desktop-boids-'+str(os.getuid()))
        runtime.mkdir(mode=0o700,exist_ok=True)
        with (runtime/'lock').open('a') as lock:
            try: fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
            except BlockingIOError: sys.exit(0)
            fcntl.flock(lock,fcntl.LOCK_UN)
        log=Path.home()/'.cache/desktop-boids.log';log.parent.mkdir(exist_ok=True)
        with log.open('ab') as out:
            subprocess.Popen(['/usr/bin/python3',str(APP/'boids.py')],stdin=subprocess.DEVNULL,stdout=out,stderr=subprocess.STDOUT,start_new_session=True)
elif action=='settings':
    subprocess.Popen(['/usr/bin/python3',str(APP/'controls.py')],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
else: sys.exit('Use status, toggle, on, off or settings')
